{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sage-mode recall index",
  "type": "object",
  "required": ["version", "builtAt", "docs", "skills", "stats"],
  "properties": {
    "version": { "const": 1 },
    "builtAt": { "type": "string" },
    "docs": { "type": "array" },
    "skills": { "type": "array" },
    "stats": {
      "type": "object",
      "required": ["N", "avgdl", "df"],
      "properties": {
        "N": { "type": "number" },
        "avgdl": { "type": "number" },
        "df": { "type": "object" }
      }
    }
  }
}
