{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "./sage-bootstrap", "type": "command", "timeout": 5 }
    ],
    "beforeShellExecution": [
      { "command": "./sage-careful", "type": "command", "timeout": 5 }
    ],
    "preToolUse": [
      {
        "command": "./sage-lane",
        "type": "command",
        "timeout": 5,
        "failClosed": true,
        "matcher": "Write|Delete"
      }
    ],
    "afterFileEdit": [
      { "command": "./sage-lane-after", "type": "command", "timeout": 5 }
    ],
    "subagentStart": [
      { "command": "./sage-solo", "type": "command", "timeout": 5, "failClosed": true }
    ],
    "stop": [
      { "command": "./sage-proof", "type": "command", "timeout": 20, "loop_limit": 3 }
    ]
  }
}
