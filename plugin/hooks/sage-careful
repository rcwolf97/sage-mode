#!/usr/bin/env sh
# sage-careful — beforeShellExecution (Cursor) / PreToolUse matcher "Bash"
# (Claude Code — there is no beforeShellExecution event there). Ask-tier;
# never failClosed.
# HIGH deny only for simple (non-compound) recursive delete of / ~ $HOME /* and force-push to default branch.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$DIR/json-safe.sh"
. "$DIR/host-detect.sh"
json_read
sage_detect_host
# POSIX-portable literal newline for use inside case patterns (the $'\n'
# ANSI-C-quote form is a bash extension and is silently a no-op glob under
# dash, defeating embedded-newline / compound-command detection).
NL='
'
if [ -z "${JSON_IN:-}" ]; then
  emit_allow
fi
if ! json_valid; then
  emit_ask "[careful] Could not parse payload. Asking (fail open)."
fi

CMD=$(json_get command)
[ -n "$CMD" ] || CMD=$(json_get tool_input.command)

# one-turn escape hatch
UNSAFE=""
ROOT="$SAGE_PROJECT_DIR"
if [ -f "$ROOT/.sage/unsafe" ]; then
  UNSAFE=1
  rm -f "$ROOT/.sage/unsafe"
fi
if [ -n "$UNSAFE" ]; then
  emit_allow
fi

# obfuscation tripwire — ASK first
case "$CMD" in
  *'${IFS}'*|*'${ifs}'*|*base64*\|*sh*|*base64*\|*bash*)
    emit_ask "[careful] Obfuscated command. Confirm before running."
    ;;
esac

IS_SIMPLE=1
case "$CMD" in
  *';'*|*'&&'*|*'||'*|*'|'*|*"$NL"*) IS_SIMPLE=0 ;;
esac

# safe exceptions — anchored whole-command, single-line only
case "$CMD" in
  *"$NL"*) ;;
  'rm -rf node_modules'|'rm -rf .next'|'rm -rf dist'|'rm -rf __pycache__'|'rm -rf .cache'|'rm -rf build'|'rm -rf .turbo'|'rm -rf coverage'|\
  'rm -rf ./node_modules'|'rm -rf ./dist')
    emit_allow
    ;;
esac

deny() {
  emit_deny "$1"
}
ask() {
  emit_ask "$1"
}

# Token-aware scan of $CMD, computed unconditionally (not just when
# IS_SIMPLE) because the MEDIUM-tier "ask" fallback below needs it too. An
# adversarial test found the old MEDIUM tier used a second, weaker matcher —
# literal `case "$CMD" in *'rm -r'*)` — that missed flag-order variants
# (`rm -fr`, `rm --force --recursive`) the HIGH tier's own scan already
# handles correctly, and silently allowed them through as `{}` instead of
# even asking. Rather than maintain two matchers that can drift out of sync,
# compute the token scan once and let both tiers read from it.
#
# Tokenize on whitespace (collapsing repeats) and match on the ARGUMENT SET
# rather than the literal string, so extra flags anywhere in the command
# (e.g. --no-preserve-root), a leading `sudo`, doubled spaces, and
# flag-order/case variants (-rf / -fr / -Rf / "-r -f") don't slip past an
# exact-string check. `set -f` guards against the shell glob-expanding a
# bare `/*` token against the real filesystem during the split.
set -f
# shellcheck disable=SC2086
set -- $CMD
set +f
# Anchor: is `rm` actually the command being invoked, not just a token that
# happens to appear somewhere in the argument list? An adversarial re-review
# found this loop originally scanned every token unconditionally for a
# literal `rm`, so `echo rm -rf /` — which never runs rm at all — was
# hard-denied: the "rm" token from echo's own argument tripped it. gstack's
# equivalent check anchors the same way this now does (`^(sudo )?rm\b`);
# mirror that rather than reinvent it. `\rm` (the common alias-bypass
# spelling) is also accepted as the command. Checked against the *unshifted*
# $1/$2 so the token list below is unaffected. This anchored HAS_RM is what
# gates the HIGH-tier hard deny below (IS_SIMPLE only); the looser MED_HAS_RM
# a few lines down (any token, not just the first) is what gates the
# MEDIUM-tier ask, and runs even on compound commands where the anchor can't
# be trusted — a false-positive ask there costs nothing, unlike a false
# deny.
CMD_TOK1=$1
CMD_TOK2=${2:-}
HAS_RM=0
case "$CMD_TOK1" in
  rm | \\rm) HAS_RM=1 ;;
  sudo) case "$CMD_TOK2" in rm | \\rm) HAS_RM=1 ;; esac ;;
esac
MED_HAS_RM=0
for tok in "$@"; do
  case "$tok" in rm | \\rm) MED_HAS_RM=1 ;; esac
done
HAS_R=0
HAS_F=0
TARGET_ROOT=0
TARGET_HOME=0
TARGET_ROOTSTAR=0
for tok in "$@"; do
  case "$tok" in
    --recursive) HAS_R=1 ;;
    --force) HAS_F=1 ;;
    --*) : ;; # any other long option: ignore, never substring-matched
    -?*)
      # short-option cluster, e.g. -r -f -rf -fr -Rf: any letter order,
      # case-insensitive on r (rm accepts -R as a recursive alias too)
      case "$tok" in *r*|*R*) HAS_R=1 ;; esac
      case "$tok" in *f*|*F*) HAS_F=1 ;; esac
      ;;
  esac
  # Quoted variants (rm -rf "/" or rm -rf '/') matter here: word-splitting
  # $CMD does NOT strip quote characters from the resulting tokens (quote
  # removal only happens on the original parse, not on a second unquoted
  # expansion) — so a quoted root is a literal 3-character token `"/"` or
  # `'/'`, not a 1-character `/`. An adversarial test caught this falling
  # through to the weaker MEDIUM ask tier instead of HIGH deny. $HOME's
  # quoted form was already covered ('"$HOME"'); root and /* were not.
  case "$tok" in
    '/'|'"/"'|"'/'") TARGET_ROOT=1 ;;
    '~'|'~/'|'$HOME'|'"$HOME"'|'~/*') TARGET_HOME=1 ;;
    '/*'|'"/*"'|"'/*'") TARGET_ROOTSTAR=1 ;;
  esac
done

if [ "$IS_SIMPLE" = 1 ]; then
  # -f is not required to deny: the original literal-pattern list already
  # hard-denied bare `rm -r /` (no force flag) alongside `rm -rf /`, since a
  # non-interactive recursive delete of / is dangerous with or without -f.
  # HAS_F is tracked only so `rm -f /` alone (no recursion — genuinely
  # harmless: rm errors on "/" being a directory) does not.
  if [ "$HAS_RM" = 1 ] && [ "$HAS_R" = 1 ]; then
    [ "$TARGET_ROOT" = 1 ] && deny "[careful] Refusing recursive delete of /."
    [ "$TARGET_HOME" = 1 ] && deny "[careful] Refusing recursive delete of home."
    [ "$TARGET_ROOTSTAR" = 1 ] && deny "[careful] Refusing recursive delete of /*."
  fi
  # force-push to default branch — token-aware, mirrors the rm -rf detection
  # above. An adversarial test found the previous literal-substring check
  # ('git push --force' / 'git push -f ' with a trailing space) missed a
  # force flag bundled into a short-option cluster, e.g. `git push -uf origin
  # main` — that command force-pushes to main but matched neither pattern,
  # so it got neither a deny nor even the MEDIUM ask fallback. Detect the
  # force flag the same way -r/-f are detected for rm: scan every token's
  # short-option cluster, not just a couple of literal spellings.
  IS_GIT_PUSH=0
  case "$CMD_TOK1" in
    git) case "$CMD_TOK2" in push) IS_GIT_PUSH=1 ;; esac ;;
  esac
  if [ "$IS_GIT_PUSH" = 1 ]; then
    HAS_FORCE=0
    for tok in "$@"; do
      case "$tok" in
        --force|--force-with-lease|--force-with-lease=*) HAS_FORCE=1 ;;
        --*) : ;;
        -?*) case "$tok" in *f*) HAS_FORCE=1 ;; esac ;;
      esac
    done
    if [ "$HAS_FORCE" = 1 ]; then
      DEF=$(git -C "$ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@origin/@@')
      [ -n "$DEF" ] || DEF=main
      case "$CMD" in
        *" $DEF"*|*origin/$DEF*|*"HEAD:$DEF"*) deny "[careful] Force-push to default branch ($DEF) denied." ;;
      esac
      ask "[careful] Destructive command. Confirm to proceed."
    fi
  fi
fi

# MEDIUM — always ask.
#
# Recursive rm: reuse the token scan above (MED_HAS_RM is the loose,
# not-anchored-to-token-1 variant — safe here because asking on a false
# positive costs nothing, unlike the HIGH tier's hard deny). This is what
# catches `rm -fr`, `rm --force --recursive`, and any other flag order the
# old literal `*'rm -r'*` substring pattern missed.
MED_ASK=0
if [ "$MED_HAS_RM" = 1 ] && [ "$HAS_R" = 1 ]; then
  MED_ASK=1
fi

# SQL keywords: case-insensitive. The old pattern only matched the literal
# uppercase spelling ('DROP TABLE'), so `drop table users;` — a command
# nobody types in all-caps in practice — sailed through unasked. Uppercase a
# copy of $CMD once and match against that instead of hand-rolling a
# case-insensitive glob for every keyword.
CMD_UPPER=$(printf '%s' "$CMD" | tr 'a-z' 'A-Z')
case "$CMD_UPPER" in
  *'DROP TABLE'*|*'DROP DATABASE'*|*'TRUNCATE'*) MED_ASK=1 ;;
esac

case "$CMD" in
  *'git push --force'*|*'git push -f '*|*'git reset --hard'*|*'git checkout .'*|*'git restore .'*|*'kubectl delete'*|*'docker rm -f'*|*'docker system prune'*)
    MED_ASK=1
    ;;
esac

[ "$MED_ASK" = 1 ] && ask "[careful] Destructive command. Confirm to proceed."

emit_allow
