#!/usr/bin/env sh
# sage-careful — beforeShellExecution. Ask-tier; never failClosed.
# HIGH deny only for simple (non-compound) recursive delete of / ~ $HOME /* and force-push to default branch.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$DIR/json-safe.sh"
json_read
# POSIX-portable literal newline for use inside case patterns (the $'\n'
# ANSI-C-quote form is a bash extension and is silently a no-op glob under
# dash, defeating embedded-newline / compound-command detection).
NL='
'
if [ -z "${JSON_IN:-}" ]; then
  printf '%s\n' '{}'
  exit 0
fi
if ! json_valid; then
  # fail open to ask
  python3 -c 'import json; print(json.dumps({"permission":"ask","agent_message":"[careful] Could not parse payload. Asking (fail open)."}))' 2>/dev/null || printf '%s\n' '{"permission":"ask"}'
  exit 0
fi

CMD=$(json_get command)
[ -n "$CMD" ] || CMD=$(json_get tool_input.command)

# one-turn escape hatch
UNSAFE=""
ROOT="${CURSOR_PROJECT_DIR:-.}"
if [ -f "$ROOT/.sage/unsafe" ]; then
  UNSAFE=1
  rm -f "$ROOT/.sage/unsafe"
fi
if [ -n "$UNSAFE" ]; then
  printf '%s\n' '{}'
  exit 0
fi

# obfuscation tripwire — ASK first
case "$CMD" in
  *'${IFS}'*|*'${ifs}'*|*base64*\|*sh*|*base64*\|*bash*)
    python3 -c 'import json; print(json.dumps({"permission":"ask","agent_message":"[careful] Obfuscated command. Confirm before running."}))' 2>/dev/null || printf '%s\n' '{"permission":"ask"}'
    exit 0
    ;;
esac

IS_SIMPLE=1
case "$CMD" in
  *';'*|*'&&'*|*'||'*|*'|'*|*"$NL"*) IS_SIMPLE=0 ;;
esac

# safe exceptions — anchored whole-command, single-line only
case "$CMD" in
  *"$NL"*) ;;
  'rm -rf node_modules'|'rm -rf .next'|'rm -rf dist'|'rm -rf __pycache__'|'rm -rf .cache'|'rm -rf build'|'rm -rf .turbo'|'rm -rf coverage'|\
  'rm -rf ./node_modules'|'rm -rf ./dist')
    printf '%s\n' '{}'
    exit 0
    ;;
esac

deny() {
  msg=$1
  python3 -c 'import json,sys; print(json.dumps({"permission":"deny","agent_message":sys.argv[1],"user_message":sys.argv[1]}))' "$msg" 2>/dev/null || printf '%s\n' '{"permission":"deny"}'
  exit 0
}
ask() {
  msg=$1
  python3 -c 'import json,sys; print(json.dumps({"permission":"ask","agent_message":sys.argv[1],"user_message":sys.argv[1]}))' "$msg" 2>/dev/null || printf '%s\n' '{"permission":"ask"}'
  exit 0
}

if [ "$IS_SIMPLE" = 1 ]; then
  # Token-aware recursive delete of exactly / ~ $HOME /*.
  #
  # Tokenize on whitespace (collapsing repeats) and match on the ARGUMENT
  # SET rather than the literal string, so extra flags anywhere in the
  # command (e.g. --no-preserve-root), a leading `sudo`, doubled spaces, and
  # flag-order/case variants (-rf / -fr / -Rf / "-r -f") don't slip past an
  # exact-string check. `set -f` guards against the shell glob-expanding a
  # bare `/*` token against the real filesystem during the split.
  set -f
  # shellcheck disable=SC2086
  set -- $CMD
  set +f
  # Anchor: is `rm` actually the command being invoked, not just a token
  # that happens to appear somewhere in the argument list? An adversarial
  # re-review found this loop originally scanned every token unconditionally
  # for a literal `rm`, so `echo rm -rf /` — which never runs rm at all —
  # was hard-denied: the "rm" token from echo's own argument tripped it.
  # gstack's equivalent check anchors the same way this now does
  # (`^(sudo )?rm\b`); mirror that rather than reinvent it. `\rm` (the
  # common alias-bypass spelling) is also accepted as the command. Checked
  # against the *unshifted* $1/$2 so the token list below is unaffected.
  CMD_TOK1=$1
  CMD_TOK2=${2:-}
  HAS_RM=0
  case "$CMD_TOK1" in
    rm | \\rm) HAS_RM=1 ;;
    sudo) case "$CMD_TOK2" in rm | \\rm) HAS_RM=1 ;; esac ;;
  esac
  HAS_R=0
  HAS_F=0
  TARGET_ROOT=0
  TARGET_HOME=0
  TARGET_ROOTSTAR=0
  for tok in "$@"; do
    case "$tok" in
      --recursive) HAS_R=1 ;;
      --force) HAS_F=1 ;;
      --*) : ;; # any other long option: ignore, never substring-matched
      -?*)
        # short-option cluster, e.g. -r -f -rf -fr -Rf: any letter order,
        # case-insensitive on r (rm accepts -R as a recursive alias too)
        case "$tok" in *r*|*R*) HAS_R=1 ;; esac
        case "$tok" in *f*|*F*) HAS_F=1 ;; esac
        ;;
    esac
    # Quoted variants (rm -rf "/" or rm -rf '/') matter here: word-splitting
    # $CMD does NOT strip quote characters from the resulting tokens (quote
    # removal only happens on the original parse, not on a second unquoted
    # expansion) — so a quoted root is a literal 3-character token `"/"` or
    # `'/'`, not a 1-character `/`. An adversarial test caught this falling
    # through to the weaker MEDIUM ask tier instead of HIGH deny. $HOME's
    # quoted form was already covered ('"$HOME"'); root and /* were not.
    case "$tok" in
      '/'|'"/"'|"'/'") TARGET_ROOT=1 ;;
      '~'|'~/'|'$HOME'|'"$HOME"'|'~/*') TARGET_HOME=1 ;;
      '/*'|'"/*"'|"'/*'") TARGET_ROOTSTAR=1 ;;
    esac
  done
  # -f is not required to deny: the original literal-pattern list already
  # hard-denied bare `rm -r /` (no force flag) alongside `rm -rf /`, since a
  # non-interactive recursive delete of / is dangerous with or without -f.
  # HAS_F is tracked only so `rm -f /` alone (no recursion — genuinely
  # harmless: rm errors on "/" being a directory) does not.
  if [ "$HAS_RM" = 1 ] && [ "$HAS_R" = 1 ]; then
    [ "$TARGET_ROOT" = 1 ] && deny "[careful] Refusing recursive delete of /."
    [ "$TARGET_HOME" = 1 ] && deny "[careful] Refusing recursive delete of home."
    [ "$TARGET_ROOTSTAR" = 1 ] && deny "[careful] Refusing recursive delete of /*."
  fi
  # force-push to default branch — token-aware, mirrors the rm -rf detection
  # above. An adversarial test found the previous literal-substring check
  # ('git push --force' / 'git push -f ' with a trailing space) missed a
  # force flag bundled into a short-option cluster, e.g. `git push -uf origin
  # main` — that command force-pushes to main but matched neither pattern,
  # so it got neither a deny nor even the MEDIUM ask fallback. Detect the
  # force flag the same way -r/-f are detected for rm: scan every token's
  # short-option cluster, not just a couple of literal spellings.
  IS_GIT_PUSH=0
  case "$CMD_TOK1" in
    git) case "$CMD_TOK2" in push) IS_GIT_PUSH=1 ;; esac ;;
  esac
  if [ "$IS_GIT_PUSH" = 1 ]; then
    HAS_FORCE=0
    for tok in "$@"; do
      case "$tok" in
        --force|--force-with-lease|--force-with-lease=*) HAS_FORCE=1 ;;
        --*) : ;;
        -?*) case "$tok" in *f*) HAS_FORCE=1 ;; esac ;;
      esac
    done
    if [ "$HAS_FORCE" = 1 ]; then
      DEF=$(git -C "$ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@origin/@@')
      [ -n "$DEF" ] || DEF=main
      case "$CMD" in
        *" $DEF"*|*origin/$DEF*|*"HEAD:$DEF"*) deny "[careful] Force-push to default branch ($DEF) denied." ;;
      esac
      ask "[careful] Destructive command. Confirm to proceed."
    fi
  fi
fi

# MEDIUM — always ask
case "$CMD" in
  *'rm -r'*|*'DROP TABLE'*|*'DROP DATABASE'*|*'TRUNCATE'*|*'git push --force'*|*'git push -f '*|*'git reset --hard'*|*'git checkout .'*|*'git restore .'*|*'kubectl delete'*|*'docker rm -f'*|*'docker system prune'*)
    ask "[careful] Destructive command. Confirm to proceed."
    ;;
esac

printf '%s\n' '{}'
exit 0
