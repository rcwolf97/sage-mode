#!/usr/bin/env sh
# sage-bootstrap — sessionStart (Cursor) / SessionStart (Claude Code).
# Inject <= 60 lines of sprint state + SAGE_HOME.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$DIR/json-safe.sh"
. "$DIR/host-detect.sh"
json_read
sage_detect_host
ROOT="$SAGE_PROJECT_DIR"
HOME_CFG="${HOME:-}/.sage/config.json"
SAGE_HOME=""
if [ -f "$HOME_CFG" ]; then
  SAGE_HOME=$(sed -n 's/.*"sageHome"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HOME_CFG")
fi
[ -n "$SAGE_HOME" ] || SAGE_HOME="$DIR/.."
SPRINT=""
LEDGER=""
if [ -d "$ROOT/.sage/sprints" ]; then
  LEDGER=$(find "$ROOT/.sage/sprints" -name ledger.md 2>/dev/null | sort | tail -n 1 || true)
  if [ -n "$LEDGER" ]; then
    SPRINT=$(basename "$(dirname "$LEDGER")" 2>/dev/null || true)
  fi
fi
CTX=$(printf 'sage-mode session\nSAGE_HOME=%s\nsprint=%s\n' "$SAGE_HOME" "${SPRINT:-none}")
if [ -n "$LEDGER" ] && [ -f "$LEDGER" ]; then
  CTX=$(printf '%s\n%s\n' "$CTX" "$(head -n 40 "$LEDGER")")
fi
CTX=$(printf '%s\n' "$CTX" | awk 'NR<=60')

# Piped via printf, not a `<<EOF ... $CTX ... EOF` heredoc: a heredoc whose
# body is a large variable expansion is exactly the pattern that hung
# Homebrew bash 5.3 indefinitely (see the other hooks' comments on this).
# CTX can run up to 60 lines of ledger content, so it's exactly the kind of
# "large" this applies to — piping it in avoids that heredoc entirely.
if [ "$(_sage_host)" = "claude" ]; then
  # Claude Code SessionStart context-injection shape below is MEDIUM
  # confidence — unlike the PreToolUse/Stop shapes elsewhere in this
  # codebase (given, high-confidence facts), this one is recalled from
  # general knowledge of Claude Code's hookSpecificOutput pattern and was
  # NOT independently verified against live docs in this task. The stakes
  # of being wrong are low (unlike a deny/security hook: worst case here is
  # just that the session starts with no injected context, not a security
  # regression), so — in the same belt-and-braces spirit as emit_deny —
  # both a modern hookSpecificOutput.additionalContext key AND a legacy
  # top-level additionalContext key are emitted, in case only one is
  # actually honored by a given Claude Code version.
  #
  # Also note: Claude Code's SessionStart hook has NO known mechanism for
  # injecting real process environment variables the way Cursor's "env"
  # field (below, cursor branch) does — that's Cursor-specific. So on
  # Claude Code, SAGE_HOME/SAGE_SPRINT only reach the agent as TEXT inside
  # additionalContext, never as actual env vars.
  printf '%s\n' "$CTX" | SAGE_HOME="$SAGE_HOME" SAGE_SPRINT="${SPRINT:-}" python3 -c '
import json, os, sys
ctx = sys.stdin.read()
print(json.dumps({
  "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx},
  "additionalContext": ctx,
}))
'
else
  printf '%s\n' "$CTX" | SAGE_HOME="$SAGE_HOME" SAGE_SPRINT="${SPRINT:-}" python3 -c '
import json, os, sys
ctx = sys.stdin.read()
print(json.dumps({
  "env": {"SAGE_HOME": os.environ.get("SAGE_HOME",""), "SAGE_SPRINT": os.environ.get("SAGE_SPRINT","")},
  "additional_context": ctx
}))
'
fi
