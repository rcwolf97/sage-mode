#!/usr/bin/env sh
# probe-hook — SPIKE-01 diagnostic. Registered (temporarily, by install.sh)
# on preToolUse (Cursor) / PreToolUse (Claude Code) for Write-shaped tools.
# Logs the RAW payload (BOM-stripped) it actually receives, then checks
# every plausible key for a file path and prints a verdict naming which one
# (if any) actually carried it. ALWAYS emits {} (allow) — this must never
# block a real edit, on either host, regardless of what it finds.
#
# This does NOT decide the question by itself. It only records what one
# real invocation looked like. Run it several times (a plain Write, an
# Edit, a MultiEdit if your host has one) before drawing a conclusion —
# see README.md.
set -eu
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
OUT="$DIR/out"
mkdir -p "$OUT"
PAYLOADS="$OUT/payloads.jsonl"
VERDICT="$OUT/verdict.txt"

# Captured to a temp file, not a shell variable read back into python via
# stdin: `python3 - <<'PY' ... PY` already consumes stdin to deliver the
# SCRIPT itself, so there is no stdin left over for the script to read the
# payload from. A file (as sage-lane/sage-solo already do for the same
# reason) also avoids any risk of ARG_MAX truncation on a large Write body,
# which a plain argv would not.
RAWFILE=$(mktemp "${TMPDIR:-/tmp}/spike01.XXXXXX")
trap 'rm -f "$RAWFILE"' EXIT
cat > "$RAWFILE"
# Strip a UTF-8 BOM if present (the payload is logged BOM-stripped, per
# spec) — done in the python/fallback branches below, which read this file.

TS=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "unknown-time")

if command -v python3 >/dev/null 2>&1; then
  python3 - "$TS" "$PAYLOADS" "$VERDICT" "$RAWFILE" <<'PY' 2>/dev/null || true
import json, sys, os

ts, payloads_path, verdict_path, rawfile = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(rawfile, "rb") as f:
    raw_bytes = f.read()
if raw_bytes.startswith(b"\xef\xbb\xbf"):
    raw_bytes = raw_bytes[3:]
raw = raw_bytes.decode("utf-8", errors="replace")

with open(payloads_path, "a") as f:
    f.write(json.dumps({"ts": ts, "raw": raw}) + "\n")

# Every plausible location a file path could live, in the order sage-lane
# itself already checks (see hooks/sage-lane) plus a couple of extra
# guesses, so this doubles as a check that sage-lane isn't missing one.
CANDIDATES = [
    ("tool_input.path", lambda p: (p.get("tool_input") or {}).get("path")),
    ("tool_input.file_path", lambda p: (p.get("tool_input") or {}).get("file_path")),
    ("tool_input.filePath", lambda p: (p.get("tool_input") or {}).get("filePath")),
    ("tool_input.target_file", lambda p: (p.get("tool_input") or {}).get("target_file")),
    ("tool_input.file", lambda p: (p.get("tool_input") or {}).get("file")),
    ("file_path (top-level)", lambda p: p.get("file_path")),
    ("path (top-level)", lambda p: p.get("path")),
    ("params.path", lambda p: (p.get("params") or {}).get("path")),
    ("input.path", lambda p: (p.get("input") or {}).get("path")),
]

try:
    payload = json.loads(raw) if raw.strip() else {}
except Exception as e:
    payload = None

lines = [f"--- {ts} ---"]
if payload is None:
    lines.append("VERDICT: payload did not parse as JSON — see payloads.jsonl for the raw bytes.")
else:
    found = []
    for label, getter in CANDIDATES:
        try:
            v = getter(payload)
        except Exception:
            v = None
        if v:
            found.append((label, v))
    top_keys = sorted(payload.keys()) if isinstance(payload, dict) else []
    ti_keys = sorted((payload.get("tool_input") or {}).keys()) if isinstance(payload, dict) and isinstance(payload.get("tool_input"), dict) else []
    lines.append(f"top-level keys: {top_keys}")
    lines.append(f"tool_input keys: {ti_keys}")
    if found:
        lines.append("VERDICT: file path WAS exposed, via: " + ", ".join(f"{l}={v!r}" for l, v in found))
    else:
        lines.append("VERDICT: NO candidate key carried a file path. preToolUse/PreToolUse does NOT expose it for this call — sage-lane-after (afterFileEdit/PostToolUse) is required.")

with open(verdict_path, "a") as f:
    f.write("\n".join(lines) + "\n\n")

print(json.dumps({}))
PY
else
  # No python3 — still record the raw payload (BOM-stripped) so the run
  # isn't lost, just not as JSONL (building that safely needs a real JSON
  # encoder — the same reasoning as hooks/json-safe.sh). Plain
  # timestamp-delimited text to a separate file instead; say plainly that
  # the automatic key-check needs python3.
  {
    printf -- '--- %s ---\n' "$TS"
    sed "1s/^$(printf '\357\273\277')//" "$RAWFILE" 2>/dev/null || cat "$RAWFILE"
    printf '\n'
  } >> "$OUT/payloads-raw-fallback.txt"
  printf -- '--- %s ---\nVERDICT: python3 not available on this machine — raw payload logged to payloads-raw-fallback.txt (not payloads.jsonl) but the automatic key-check did not run. Inspect that file by hand.\n\n' "$TS" >> "$VERDICT"
  printf '{}\n'
fi
