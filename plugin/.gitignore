node_modules/
*.tsbuildinfo

# Captured spike output (tools/spikes/) — payloads from a real Write call
# or subagent dispatch can contain arbitrary local content; keep captures
# out of git by default. The directories themselves stay tracked via
# out/.gitkeep in each spike.
tools/spikes/*/out/*
!tools/spikes/*/out/.gitkeep
# install.sh's backup of the live hooks config, restored by uninstall.sh.
hooks/*.spike01-orig
